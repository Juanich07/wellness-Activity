rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.active == true;
    }

    // Allow writes from server-side API endpoint (no auth context)
    // Admin operations must still verify the token on the backend
    function isServerRequest() {
      return request.auth == null;
    }

    // Admin profile records. Used by the admin login flow.
    match /admin/{adminId} {
      allow read: if (signedIn() && request.auth.uid == adminId) || isServerRequest();
      allow write: if isAdmin() || isServerRequest();
    }

    // Employee user records. Employees can read/write their own doc.
    // Admins can read all employee docs for participation and reports.
    // Server requests (API endpoint) can write when properly validated.
    match /user/{userId} {
      allow read: if (signedIn() && (request.auth.uid == userId || isAdmin())) || isServerRequest();
      allow write: if (signedIn() && (request.auth.uid == userId || isAdmin())) || isServerRequest();
    }

    // Wellness activities shown in employee app.
    // Read is public so preview routes can display content without login.
    // Writes are restricted to admin accounts.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Education topics accessible to all for reading, managed by admins.
    match /education/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progress records accessible to all for reading, managed by admins.
    match /progress/{progressId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily employee schedule and progress snapshots.
    match /dailyProgress/{progressId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if signedIn()
        && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update: if signedIn()
        && (request.auth.uid == resource.data.userId || isAdmin())
        && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
