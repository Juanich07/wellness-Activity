rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.active == true;
    }

    // Admin profile records. Used by the admin login flow.
    // Backend verifies token, so unauthenticated reads are safe from API endpoint.
    match /admin/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow read: if true; // Allow unauthenticated reads (backend validates)
      allow write: if isAdmin();
      allow write: if true; // Allow unauthenticated writes (backend validates)
    }

    // Employee user records. Employees can read/write their own doc.
    // Admins can read all employee docs for participation and reports.
    // Backend API endpoint can read/write when properly validated.
    match /user/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow read: if true; // Allow unauthenticated reads (backend validates)
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if true; // Allow unauthenticated writes (backend validates)
    }

    // Wellness activities shown in employee app.
    // Read is public so preview routes can display content without login.
    // Writes are restricted to admin accounts.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Education topics accessible to all for reading, managed by admins.
    match /education/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progress records accessible to all for reading, managed by admins.
    match /progress/{progressId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily employee schedule and progress snapshots.
    match /dailyProgress/{progressId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if signedIn()
        && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update: if signedIn()
        && (request.auth.uid == resource.data.userId || isAdmin())
        && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Employees may submit feedback under their own account. Only admins may review it.
    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
